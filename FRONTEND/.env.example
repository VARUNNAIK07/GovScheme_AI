# Environment Configuration for GovScheme AI

# Database & Vector Store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/govscheme
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=scheme_chunks

# Models & Extraction
EMBED_MODEL=BAAI/bge-small-en-v1.5
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here

# Security & Core
JWT_SECRET=govscheme_jwt_secret_dev_key_super_secure_random_string_2026
USE_STUBS=true
DOCS_DIR=data/raw

# Frontend Configuration
# When VITE_API_BASE is empty or set to mock mode, MSW handles requests.
# To connect to live backend, set: VITE_API_BASE=http://localhost:8000
VITE_API_BASE=
