# TEMPLATE ONLY: this file is committed to git and shared. Never put real values here.
# Copy it to .env (git-ignored) and fill in the real values there.

# ── PostgreSQL (Supabase) ── Project → Connect → "Session pooler" URI, then add ?sslmode=require
# Replace [YOUR-PASSWORD] including the square brackets.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Qdrant Cloud ── Cluster URL (with :6333) and an API key
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=scheme_chunks
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ── LLM providers (first = primary, rest = fallback) ──
LLM_PROVIDER_PRIORITY=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=
# optional second Groq model with its own free quota, e.g. openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# ── Scraper ──
SCRAPER_CONTACT_EMAIL=sravyaullamgunta06@gmail.com
SCRAPER_MIN_DELAY_S=2
SCRAPER_MAX_PDF_MB=50

# ── Backend (B) / Frontend (C) ──
JWT_SECRET=
USE_STUBS=true
DOCS_DIR=data
VITE_API_BASE=http://localhost:8000/api
