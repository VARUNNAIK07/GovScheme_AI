{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "backend.app.main:app", "--port", "8000"],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["frontend/frontend/node_modules/vite/bin/vite.js", "frontend/frontend", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
